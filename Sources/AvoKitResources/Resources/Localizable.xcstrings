      }
    },
    "The finger stays in the circle. Drag ↘ to set how far it reaches." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jari tetap di dalam lingkaran. Seret ↘ untuk mengatur jangkauannya."
          }
        }
      }
    },
    "The game starts in this mode. Its own controls: %lld. Click it again for its menu." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Game dimulai di mode ini. Kontrolnya sendiri: %lld. Klik lagi untuk menunya."
          }
        }
