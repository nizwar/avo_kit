          }
        }
      }
    },
    "This control works only while the mouse is locked, and clicks on the game press controls only while it is free." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontrol ini hanya bekerja saat mouse terkunci, sedangkan klik di game hanya menekan kontrol saat mouse bebas."
