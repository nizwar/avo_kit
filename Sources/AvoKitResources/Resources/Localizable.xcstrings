          "stringUnit" : {
            "state" : "translated",
            "value" : "Hotkey"
          }
        }
      }
    },
    "Hotkey: a key that touches nothing, only does its actions (switch the mode, free the mouse)." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
