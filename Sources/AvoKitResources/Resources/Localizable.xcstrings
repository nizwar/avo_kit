            "value" : "Nama mode"
          }
        }
      }
    },
    "The wheel cannot be held to run: press a key or a button." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda mouse tidak bisa ditahan untuk lari: tekan sebuah tombol."
          }
        }
      }
    },
    "The wheel drags the scroll bar: press a key to reset it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda mouse menggeser scroll bar: tekan tombol keyboard untuk me-resetnya."
          }
        }
      }
    },
    "The wheel works with Tap, Swipe and Hotkey only." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda mouse hanya bisa untuk Ketuk, Geser, dan Hotkey."
