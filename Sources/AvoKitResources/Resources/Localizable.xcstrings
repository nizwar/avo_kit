    "The d-pad pushes a joystick; drop it on the game to place one." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D-pad mendorong joystick; lepaskan di game untuk menaruhnya."
