    },
    "The game starts in “%@” now." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekarang game dimulai di “%@”."
          }
        }
      }
    },
    "The key that locks the mouse to the eye, and frees it again. Press another key to change it." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol yang mengunci mouse ke mata dan melepasnya lagi. Tekan tombol lain untuk menggantinya."
          }
        }
      }
    },
    "The keys show on the game’s buttons while you play." : {
      "localizations" : {
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tombol tampil di atas tombol game saat Anda bermain."
